{
  "name": "waste-packaging-regulator-tests",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=22.13.1"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "aliases": {
    "~": ".",
    "page-objects": "test/page-objects",
    "components": "test/components"
  },
  "scripts": {
    "clean": "rm -rf allure-results && rm -rf allure-report",
    "create:folders": "mkdir -p allure-results && mkdir -p allure-report",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:security": "PROFILE=security playwright test",
    "test:accessibility": "PROFILE=accessibility playwright test",
    "test:debug": "playwright test --config=playwright.local.config.js --debug",
    "test:local": "playwright test --config=playwright.local.config.js --headed",
    "install:browsers": "playwright install --with-deps chromium",
    "report": "allure generate allure-results --single-file --clean -o allure-report",
    "report:publish": "npm run report; ./bin/publish-tests.sh",
    "docker:test:local": "npm run create:folders && docker compose run --build --rm waste-packaging-regulator-tests",
    "format": "prettier --write \"test/**/*.js\" \"**/*.{js,md,json,config.js}\"",
    "format:check": "prettier --check \"test/**/*.js\" \"**/*.{js,md,json,config.js}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "postinstall": "npm run setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "dependencies": {
    "@playwright/test": "1.59.1",
    "@axe-core/playwright": "4.11.3",
    "allure-commandline": "2.34.1",
    "allure-playwright": "3.3.2",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "9.1.7",
    "prettier": "3.4.2"
  }
}
