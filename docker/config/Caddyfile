:80 {
    # Requests under /certificates-of-compliance are handled by the app at its
    # root — the prefix is stripped and X-Forwarded-Prefix is set so the app
    # generates correct absolute URLs (backlinks, action URLs, etc.).
    @coc path /certificates-of-compliance /certificates-of-compliance/*
    handle @coc {
        uri strip_prefix /certificates-of-compliance
        request_header X-Forwarded-Prefix /certificates-of-compliance
        reverse_proxy waste-packaging-regulators-fe:3000
    }

    # All other paths (health, auth callbacks, static assets, etc.) are
    # forwarded to the app without a prefix.
    reverse_proxy waste-packaging-regulators-fe:3000
}
